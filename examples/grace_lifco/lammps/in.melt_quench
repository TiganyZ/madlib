# -var data -var model -var seed -var tmelt -var out
units           metal
atom_style      atomic
boundary        p p p
read_data       ${data}
variable        species index "Li C O F"

pair_style      grace/fs
pair_coeff      * * ${model} ${species}
neighbor        1.0 bin
timestep        0.0005

thermo_style    custom step temp pe press vol density
thermo_modify   flush yes
thermo          1000

velocity        all create ${tmelt} ${seed} mom yes rot yes dist gaussian
# pressures in bar
fix             md all npt temp ${tmelt} ${tmelt} 0.05 iso 1.0 1.0 0.5
run             20000
unfix           md
fix             md all npt temp ${tmelt} 300.0 0.05 iso 1.0 1.0 0.5
run             40000
unfix           md
fix             md all npt temp 300.0 300.0 0.05 iso 1.0 1.0 0.5
run             20000
write_data      ${out}
