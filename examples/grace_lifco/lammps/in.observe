# XRD of each frame of a dump, no forces. -var start -var frames -var target -var out
units           metal
atom_style      atomic
boundary        p p p
read_data       ${start}

pair_style      zero 7.0
pair_coeff      * *
comm_modify     cutoff 9.0

compute         gr all mad/pdf r 0.1 6.0 201 kde 0.1
fix             xrd all mad/xrd c_gr target ${target} q 1.0 10.0 181 output qFq &
                species Li C O F gamma 0.0 file ${out} write_every 1
thermo_style    custom step f_xrd[2]
rerun           ${frames} dump x y z box yes
