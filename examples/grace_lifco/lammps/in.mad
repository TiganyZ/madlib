# -var extrap 1 adds the grace/fs extrapolation grade (needs an .asi in coeff)
# -var start -var pair -var coeff -var target -var gamma -var temp -var seed -var steps -var every -var prefix
units           metal
atom_style      atomic
boundary        p p p
read_data       ${start}

pair_style      ${pair}
pair_coeff      * * ${coeff} Li C O F
neighbor        1.0 bin
timestep        0.0005
comm_modify     cutoff 9.0

compute         gr all mad/pdf r 0.1 6.0 201 kde 0.1
fix             xrd all mad/xrd c_gr target ${target} q 1.0 10.0 181 output qFq &
                species Li C O F gamma ${gamma} file ${prefix}_xrd.dat write_every ${every}

variable        extrap index 0
if "${extrap} == 1" then &
   "fix gam all pair ${every} grace/fs gamma 1" &
   "compute gmax all reduce max f_gam" &
   "variable gmax equal c_gmax" &
else &
   "variable gmax equal 0"

velocity        all create ${temp} ${seed} mom yes rot yes dist gaussian
fix             md all nvt temp ${temp} ${temp} 0.05

thermo_style    custom step temp pe f_xrd f_xrd[2] f_xrd[3] press v_gmax
thermo_modify   flush yes
thermo          ${every}
dump            traj all custom ${every} ${prefix}.dump id type element x y z
dump_modify     traj element Li C O F sort id format float %20.12g
run             ${steps}
