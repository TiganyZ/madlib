# MAD-biased NVT with PolarMACE. -var start -var target -var gamma -var temp -var seed -var steps -var every
# -var prefix, plus mace_potential.lmp's
units           metal
atom_style      atomic
boundary        p p p
read_data       ${start}
include         ${potential}
neighbor        1.0 bin
timestep        0.0005
comm_modify     cutoff 9.0

compute         gr all mad/pdf r 0.1 6.0 201 kde 0.1
fix             xrd all mad/xrd c_gr target ${target} q 1.0 10.0 181 output qFq &
                species ${species} gamma ${gamma} file ${prefix}_xrd.dat write_every ${every}

velocity        all create ${temp} ${seed} mom yes rot yes dist gaussian
fix             md all nvt temp ${temp} ${temp} 0.05

thermo_style    custom step temp pe f_xrd f_xrd[2] f_xrd[3] press
thermo_modify   flush yes
thermo          ${every}
dump            traj all custom ${every} ${prefix}.dump id type element x y z
dump_modify     traj element ${species} sort id format float %20.12g
run             ${steps}
