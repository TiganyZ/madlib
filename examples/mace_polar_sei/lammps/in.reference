# The synthetic experiment: NVT with the reference model, frames dumped for their XRD.
# -var start -var temp -var seed -var equil -var sample -var every, plus mace_potential.lmp's
units           metal
atom_style      atomic
boundary        p p p
read_data       ${start}
include         ${potential}
neighbor        1.0 bin
timestep        0.0005

thermo_style    custom step temp pe press
thermo_modify   flush yes
thermo          100

velocity        all create ${temp} ${seed} mom yes rot yes dist gaussian
fix             md all nvt temp ${temp} ${temp} 0.05
run             ${equil}
dump            traj all custom ${every} frames.dump id type element x y z
dump_modify     traj element ${species} sort id format float %20.12g
run             ${sample}
