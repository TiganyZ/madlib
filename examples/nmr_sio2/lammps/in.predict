# Author: Tigany Zarrouk (tiganyzarrouk@gmail.com)
#
# Predict the 29Si powder lineshape and the 17O quadrupolar parameters of one
# silica model, and score the lineshape against the DFT one. Nothing is biased
# here: gamma is zero, which is also how the bias energy scale is sized.
#
# The model paths come from MADLIB_NMR_MODELS in the environment, not from a
# LAMMPS variable: LAMMPS does not substitute ${...} inside a quoted argument,
# and a config string with spaces in it has to be quoted.
#
#   export MADLIB_NMR_MODELS=/path/to/models
#   lmp -in in.predict -var data silica.data -var target si29_dft.dat

units           metal
atom_style      atomic
boundary        p p p
read_data       ${data}

# The energy is a classical potential and the observable is a graph network:
# MADLIB does not care that they come from different decades.
pair_style      vashishta
pair_coeff      * * SiO.1990.vashishta Si O

group           si type 1

# One model, three quantities, one forward pass a step: the computes share a
# loaded model and its cached graph, so only the reduction differs.
compute sig all mad/property/python madlib_models ncomp 6 pbc yes &
            config "backend=nequip_nmr parameter=ms quantity=tensor6 model=$MADLIB_NMR_MODELS/ms stats=$MADLIB_NMR_MODELS/data_mean_std.json types=Si,O"
compute iso all mad/property/python madlib_models ncomp 1 pbc yes &
            config "backend=nequip_nmr parameter=ms quantity=iso model=$MADLIB_NMR_MODELS/ms stats=$MADLIB_NMR_MODELS/data_mean_std.json types=Si,O"
compute spn all mad/property/python madlib_models ncomp 1 pbc yes &
            config "backend=nequip_nmr parameter=ms quantity=span model=$MADLIB_NMR_MODELS/ms stats=$MADLIB_NMR_MODELS/data_mean_std.json types=Si,O"

# The field gradient model is a second model, so a second forward pass. Vzz is
# in the model's own units; eta is dimensionless and is a diagnostic, not
# something to bias on -- its gradient is unbounded where the gradient vanishes.
compute vzz all mad/property/python madlib_models ncomp 1 pbc yes &
            config "backend=nequip_nmr parameter=efg quantity=vzz model=$MADLIB_NMR_MODELS/efg stats=$MADLIB_NMR_MODELS/data_mean_std.json types=Si,O"
compute eta all mad/property/python madlib_models ncomp 1 pbc yes &
            config "backend=nequip_nmr parameter=efg quantity=etaq model=$MADLIB_NMR_MODELS/efg stats=$MADLIB_NMR_MODELS/data_mean_std.json types=Si,O"

# delta = 328.4 - sigma: the referencing constant belongs to the level of
# theory the model was fitted at. Check it against your own before trusting an
# absolute position.
fix     si29 si mad/nmr/aniso c_sig target ${target} range -140.0 -60.0 201 &
             sigma 2.0 orientations 1024 reference 328.4 gamma 0.0 &
             file si29_predicted.dat write_every 1

compute pepair all pe pair
thermo_style    custom step c_pepair f_si29 f_si29[2] f_si29[3]
thermo_modify   format float %.8g
dump            d all custom 1 nmr_sites.dump id type c_iso c_spn c_vzz c_eta
dump_modify     d format float %.6f sort id
run 0
