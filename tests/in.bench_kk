# Timing only: turbogap/kk on a replicated glassy-carbon cell.
units           metal
atom_style      atomic
boundary        p p p
read_data       data/gc91.data
replicate       ${rx} ${ry} ${rz}
mass            1 12.011
mass            2 15.999
pair_style      turbogap/kk e0 C -.16138053 e0 O 0.0
pair_coeff      * * data/gap_files/CO.gap C O
velocity        all create 300.0 12345
fix             1 all nve
thermo          10
thermo_style    custom step pe temp
run             ${nsteps}
