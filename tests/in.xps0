units           metal
atom_style      atomic
boundary        p p p
read_data       data/gc91.data
mass            * 12.011
pair_style      zero 7.5
pair_coeff      * *
neighbor        0.5 bin

compute cn  all mad/property/coord cutoff 1.7 2.1
fix     mad all mad/xps c_cn target data/xps_target.dat energy 0.0 5.0 201 &
        sigma 0.25 gamma 0.0 file xps_pred.dat

dump d all custom 1 cn.dump id type c_cn
dump_modify d format float %.17g sort id
run 0
