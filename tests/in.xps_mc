variable        bias index yes
units           metal
atom_style      atomic
boundary        p p p
read_data       data/gc91.data
mass            * 12.011
pair_style      zero 7.5
pair_coeff      * *
neighbor        0.5 bin

compute cn  all mad/property/coord cutoff 1.7 2.1
fix     mad all mad/xps c_cn target data/xps_target.dat energy 0.0 5.0 201 &
        sigma 0.25 gamma 500.0
fix_modify mad energy ${bias}

fix     mc all gcmc 5 0 30 1 48291 300.0 0.0 0.25 full_energy

thermo 100
thermo_style custom step f_mad f_mad[2] f_mc[1] f_mc[2]
thermo_modify format float %.8g
run 300
