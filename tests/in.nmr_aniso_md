# Author: Tigany Zarrouk (tiganyzarrouk@gmail.com)
#
# Ten steps of biased dynamics, not one point of it: a ghost force written in
# post_force is dropped after the reverse communication, which run 0 cannot
# see and step 1 can.
units           metal
atom_style      atomic
boundary        p p p
read_data       data/gc91.data
mass            * 12.011
pair_style      zero 7.5
pair_coeff      * *
neighbor        0.5 bin

compute t   all mad/property/python madlib_models ncomp 6 cutoff 3.0 &
            config "backend=callable fn=mad_tensor_toy:tensor types=C,O quantity=tensor6"
fix     mad all mad/nmr/aniso c_t target data/nmr_aniso_target.dat &
            range 75.0 95.0 101 sigma 0.5 orientations 24 &
            reference 100.0 slope 1.0 gamma 50.0

velocity        all create 300.0 4928459 mom yes rot yes dist gaussian
fix             nve all nve
timestep        0.0005
compute vir all pressure NULL virial
thermo_style    custom step f_mad f_mad[2] f_mad[3] c_vir[1] c_vir[4]
thermo_modify   format float %.17g
thermo          10
run 10
