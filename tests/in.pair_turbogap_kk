# Author: Tigany Zarrouk (tiganyzarrouk@gmail.com)
#
# The same as in.pair_turbogap, through turbogap/kk. A whole TurboGAP potential as a LAMMPS pair style: soap_turbo, distance_2b,
# angle_3b and core_pot, on the 91-atom glassy-carbon cell the rest of the
# suite uses.
units           metal
atom_style      atomic
boundary        p p p
read_data       data/gc91.data
mass            1 12.011
mass            2 15.999

# e0 is a TurboGAP input parameter, not part of the .gap file, so it is given
# here. These are the values tests/regression/cases/xrd_predict uses.
pair_style      turbogap/kk e0 C -.16138053 e0 O 0.0
pair_coeff      * * data/gap_files/CO.gap C O

dump d all custom 1 pair_turbogap_kk.dump id fx fy fz
dump_modify d format float %.12f sort id
thermo_style    custom step pe
run 0
