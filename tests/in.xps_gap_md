# Author: Tigany Zarrouk (tiganyzarrouk@gmail.com)
units           metal
atom_style      atomic
boundary        p p p
read_data       data/gc91.data
mass            * 12.011
pair_style      zero 6.0
pair_coeff      * *
comm_modify     cutoff 6.0
neighbor        0.5 bin

compute cebe all mad/property/turbogap data/gap_files/CO.gap core_electron_be species C O
fix     mad  all mad/xps c_cebe target data/xps_gap_target.dat energy 280.0 540.0 521 &
        sigma 0.4 gamma 0.0 200.0

velocity all create 300.0 12345 mom yes
fix     nve all nve
fix     t   all langevin 300.0 300.0 0.1 48279
thermo 40
thermo_style custom step temp f_mad f_mad[2]
thermo_modify format float %.8g
run 200
