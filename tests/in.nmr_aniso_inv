# Author: Tigany Zarrouk (tiganyzarrouk@gmail.com)
#
# E = gamma D / 2, a bias that pushes nothing as a whole, and the same answer
# on any number of ranks.
units           metal
atom_style      atomic
boundary        p p p
read_data       data/gc91.data
mass            * 12.011
pair_style      zero 7.5
pair_coeff      * *
neighbor        0.5 bin

compute t   all mad/property/python madlib_models ncomp 6 cutoff 3.0 &
            config "backend=callable fn=mad_tensor_toy:tensor types=C,O quantity=tensor6"
fix     mad all mad/nmr/aniso c_t target data/nmr_aniso_target.dat &
            range 75.0 95.0 101 sigma 0.5 orientations 48 &
            reference 100.0 slope 1.0 gamma 100.0

compute fsx all reduce sum fx
compute fsy all reduce sum fy
compute fsz all reduce sum fz
compute vir all pressure NULL virial
thermo_style custom step f_mad f_mad[2] f_mad[3] c_fsx c_fsy c_fsz c_vir[1] c_vir[4]
thermo_modify format float %.17g
run 0
