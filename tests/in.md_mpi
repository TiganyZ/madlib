# Author: Tigany Zarrouk (tiganyzarrouk@gmail.com)
#
# Five steps of NVE, for the 1-rank against N-rank comparison. Same system and
# same integrator as in.md_ref; only the dump name differs, so the two legs do
# not overwrite each other.
units           metal
atom_style      atomic
boundary        p p p
read_data       data/gc91.data
mass            1 12.011
mass            2 15.999
pair_style      turbogap e0 C -.16138053 e0 O 0.0
pair_coeff      * * data/gap_files/CO.gap C O
velocity        all create 300.0 12345
fix             1 all nve
dump d all custom 5 md_mpi.dump id fx fy fz
dump_modify d format float %.12f sort id
thermo          5
thermo_style    custom step pe
run 5
