# Author: Tigany Zarrouk (tiganyzarrouk@gmail.com)
units           metal
atom_style      atomic
boundary        p p p
read_data       data/gc91.data
mass            * 12.011
pair_style      zero 6.5
pair_coeff      * *
neighbor        0.5 bin

compute gr  all mad/pdf r 0.1 6.0 201 rcut 6.0 kde 0.1
fix     mad all mad/pdf c_gr target data/pdf_target.dat gamma 100.0 output pdf

compute p   all pressure NULL virial
thermo_style custom step f_mad f_mad[2] f_mad[3] c_p pxx pyy pzz pxy pxz pyz
thermo_modify format float %.16g
run 0
