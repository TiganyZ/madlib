# Author: Tigany Zarrouk (tiganyzarrouk@gmail.com)
units metal
boundary p p p
atom_style atomic
read_data data/ta54.data
pair_style zero 6.0
pair_coeff * *
neighbor 0.5 bin
comm_modify cutoff 6.0
compute q all mad/property/mliap model linear data/Ta06A.mliap.model descriptor sna data/Ta06A.mliap.descriptor
fix mad all mad/xps c_q target data/mliap_flat.dat energy -18.0 -15.0 201 sigma 0.1 gamma 0.0 file mliap_pred.dat
run 0
