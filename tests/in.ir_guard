# A periodic box with no molecule IDs: sum q_i r_i has no meaning here, and
# the point of this deck is that MADLIB says so.
units           metal
atom_style      atomic
boundary        p p p
region          box block 0 20 0 20 0 20
create_box      2 box
create_atoms    1 random 20 1234 box
create_atoms    2 random 20 5678 box
mass            * 12.011
pair_style      zero 4.0
pair_coeff      * *

compute mu all mad/property/dipole charges 0.5 -0.5
fix     ir all mad/ir 1 c_mu nu_max 2000
run 0
