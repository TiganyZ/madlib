units           metal
atom_style      full
boundary        s s s
region          box block -30 30 -30 30 -30 30
create_box      2 box bond/types 1 extra/bond/per/atom 2 extra/special/per/atom 2
# a ring of CO-like dimers, so there is a real vibrational dipole
bond_style      harmonic
bond_coeff      1 25.0 1.13
special_bonds   lj 0.0 1.0 1.0
molecule        dimer data/dimer.mol
create_atoms    0 random 40 8734 box mol dimer 3491 overlap 1.5 maxtry 200

pair_style      lj/cut 8.0
pair_coeff      * * 0.01 3.0

mass            1 12.011
mass            2 15.999

velocity        all create 300.0 8712 mom yes
fix             nve all nve
fix             t   all langevin 300.0 300.0 0.5 4871

compute mu  all mad/property/dipole charges 0.5 -0.5
fix     ir  all mad/ir 2 c_mu nu_max 4000 acf_ratio 0.25 qc classical &
            smooth 5 gaussian file ir_spectrum.dat

thermo 500
thermo_style custom step temp f_ir f_ir[3]
run 4000
