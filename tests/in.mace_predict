# Author: Tigany Zarrouk (tiganyzarrouk@gmail.com)
#
# A MACE model's per-atom energies as a MADLIB property, read from a ghost
# cloud. The cutoff is 4 A where the model's graph is 2 A, which is the
# generous reading of what a two-layer model needs -- in.mace_shallow is the
# same run at 2.5 A, and the two agree exactly, because the extra shell is
# never a message.
units           metal
atom_style      atomic
boundary        p p p
read_data       data/gc91.data
mass            * 12.011
pair_style      zero 7.5
pair_coeff      * *
neighbor        0.5 bin
comm_modify     cutoff 5.0

compute q all mad/property/python madlib_models ncomp 1 cutoff 4.0 &
          config "backend=mace model=_mace_toy.model types=C,O"
dump      d all custom 1 mace_q.dump id c_q
dump_modify d format float %.17g sort id
run 0
